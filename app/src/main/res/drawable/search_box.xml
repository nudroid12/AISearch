<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_soft" />
            <corners android:radius="16dp" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_stroke" />
            <padding
                android:left="22dp"
                android:top="12dp"
                android:right="22dp"
                android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
            <padding
                android:left="22dp"
                android:top="12dp"
                android:right="22dp"
                android:bottom="12dp" />
        </shape>
    </item>
</selector>
